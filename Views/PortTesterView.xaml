<UserControl x:Class="AutomationTools.Views.PortTesterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AutomationTools.ViewModels"
             xmlns:services="clr-namespace:AutomationTools.Services">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Input Section -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" 
                     Text="{Binding InputTargetIp, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="{Binding [PortTesterIpHint], Source={x:Static services:TranslationSource.Instance}}"
                     VerticalAlignment="Bottom" Margin="0,0,16,0">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInputValid}" Value="False">
                                <Setter Property="Foreground" Value="#EF5350"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <TextBox Grid.Column="1" 
                     Text="{Binding InputTargetPorts, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="{Binding [PortTesterPortsHint], Source={x:Static services:TranslationSource.Instance}}"
                     VerticalAlignment="Bottom" Margin="0,0,16,0">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInputValid}" Value="False">
                                <Setter Property="Foreground" Value="#EF5350"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <Button Grid.Column="2" Command="{Binding StartScanCommand}" 
                    Content="{Binding [StartScan], Source={x:Static services:TranslationSource.Instance}}"
                    Style="{StaticResource MaterialDesignRaisedButton}" 
                    Width="100" Margin="0,0,8,0" VerticalAlignment="Bottom"/>

            <Button Grid.Column="3" Command="{Binding StopScanCommand}" 
                    Content="{Binding [StopScan], Source={x:Static services:TranslationSource.Instance}}"
                    Style="{StaticResource MaterialDesignOutlinedButton}" 
                    Foreground="#EF5350" BorderBrush="#EF5350"
                    Width="100" VerticalAlignment="Bottom"/>
        </Grid>

        <!-- Progress -->
        <ProgressBar Grid.Row="1" Minimum="0" Maximum="{Binding MaxProgress}" Value="{Binding TotalProgress}" 
                     Height="4" Margin="0,0,0,16" 
                     Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- Warning / Info -->
        <TextBlock Grid.Row="2" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="{Binding [PortTesterWarningMessage], Source={x:Static services:TranslationSource.Instance}}" />
                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}" />
                    <Setter Property="FontStyle" Value="Italic" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsInputValid}" Value="False">
                            <Setter Property="Text" Value="{Binding DynamicWarning}" />
                            <Setter Property="Foreground" Value="#EF5350" />
                            <Setter Property="FontStyle" Value="Normal" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Results Grid -->
        <Border Grid.Row="3" Background="{DynamicResource MaterialDesignDarkBackground}" CornerRadius="8" Padding="16">
            <ListView ItemsSource="{Binding Results}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <!-- IP Address -->
                            <TextBlock Grid.Column="0" Text="{Binding IpAddress}" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />
                            
                            <!-- Ports List -->
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Ports}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="PortChip" CornerRadius="4" Background="#333333" Padding="8,4" Margin="0,0,8,4">
                                            <TextBlock Text="{Binding PortNumber}" FontSize="12" Foreground="White" FontWeight="Bold"/>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:PortStatus.Success}">
                                                <Setter TargetName="PortChip" Property="Background" Value="#4CAF50"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:PortStatus.Failed}">
                                                <Setter TargetName="PortChip" Property="Background" Value="#EF5350"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:PortStatus.Pending}">
                                                <Setter TargetName="PortChip" Property="Background" Value="#757575"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</UserControl>
