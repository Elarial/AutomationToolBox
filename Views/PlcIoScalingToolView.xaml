<UserControl x:Class="AutomationTools.Views.PlcIoScalingToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:services="clr-namespace:AutomationTools.Services"
             xmlns:vm="clr-namespace:AutomationTools.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="400"
             d:DataContext="{d:DesignInstance Type=vm:PlcIoScalingToolViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Settings Section -->
        <Border Grid.Row="0" Background="{DynamicResource MaterialDesignPaper}" Margin="0" Padding="16">
            <StackPanel>
                <TextBlock Text="{Binding [PlcIoSettings], Source={x:Static services:TranslationSource.Instance}}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,16"/>
                
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <ComboBox Grid.Column="0" ItemsSource="{Binding PlcPresets}" SelectedItem="{Binding SelectedPlcPreset}" 
                              materialDesign:HintAssist.Hint="{Binding [PlcIoPresetHint], Source={x:Static services:TranslationSource.Instance}}" Style="{StaticResource MaterialDesignFloatingHintComboBox}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox Grid.Column="2" ItemsSource="{Binding SignalTypes}" SelectedItem="{Binding SelectedSignalType}" 
                              materialDesign:HintAssist.Hint="{Binding [PlcIoSignalTypeHint], Source={x:Static services:TranslationSource.Instance}}" Style="{StaticResource MaterialDesignFloatingHintComboBox}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,0,0,16" Visibility="{Binding SelectedPlcPreset.IsCustom, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding PlcMin, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="{Binding [PlcIoPlcMinHint], Source={x:Static services:TranslationSource.Instance}}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
                    <TextBox Grid.Column="2" Text="{Binding PlcMax, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="{Binding [PlcIoPlcMaxHint], Source={x:Static services:TranslationSource.Instance}}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding EngMin, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="{Binding [PlcIoEngMinHint], Source={x:Static services:TranslationSource.Instance}}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
                    <TextBox Grid.Column="2" Text="{Binding EngMax, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="{Binding [PlcIoEngMaxHint], Source={x:Static services:TranslationSource.Instance}}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Precision Info -->
        <Border Grid.Row="1" Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="8" Margin="16,0,16,16" Padding="12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="Target" Width="20" Height="20" VerticalAlignment="Center" Foreground="White"/>
                <TextBlock Text="{Binding PrecisionText}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource MaterialDesignBody}"/>
            </StackPanel>
        </Border>

        <!-- Live Conversion Section -->
        <Border Grid.Row="2" Background="{DynamicResource MaterialDesignPaper}" Margin="16,0,16,16" Padding="16" CornerRadius="8" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{Binding [PlcIoLiveConversion], Source={x:Static services:TranslationSource.Instance}}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,24" HorizontalAlignment="Center"/>
                
                <TextBox Text="{Binding RawValueText, UpdateSourceTrigger=PropertyChanged}" 
                         materialDesign:HintAssist.Hint="{Binding [PlcIoRawValueHint], Source={x:Static services:TranslationSource.Instance}}" 
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                         FontSize="18" FontWeight="Medium" TextAlignment="Center" Margin="0,0,0,24"/>
                         
                <materialDesign:PackIcon Kind="SwapVertical" Width="24" Height="24" HorizontalAlignment="Center" Foreground="{DynamicResource MaterialDesignDivider}" Margin="0,0,0,24"/>

                <TextBox Text="{Binding SignalValueText, UpdateSourceTrigger=PropertyChanged}" 
                         materialDesign:HintAssist.Hint="{Binding [PlcIoSignalTypeHint], Source={x:Static services:TranslationSource.Instance}}" 
                         materialDesign:TextFieldAssist.SuffixText="{Binding SelectedSignalType.Unit}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                         FontSize="18" FontWeight="Medium" TextAlignment="Center" Margin="0,0,0,24"/>

                <materialDesign:PackIcon Kind="SwapVertical" Width="24" Height="24" HorizontalAlignment="Center" Foreground="{DynamicResource MaterialDesignDivider}" Margin="0,0,0,24"/>

                <TextBox Text="{Binding EngValueText, UpdateSourceTrigger=PropertyChanged}" 
                         materialDesign:HintAssist.Hint="{Binding [PlcIoEngineeringValueHint], Source={x:Static services:TranslationSource.Instance}}" 
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                         FontSize="18" FontWeight="Medium" TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Warnings -->
        <Border Grid.Row="3" Background="#33EF5350" CornerRadius="8" Margin="16,0,16,16" Padding="12" Visibility="{Binding IsOutOfRange, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="AlertCircleOutline" Width="20" Height="20" VerticalAlignment="Center" Foreground="#EF5350"/>
                <TextBlock Text="{Binding OutOfRangeWarning}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#EF5350"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
