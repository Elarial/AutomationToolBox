<UserControl x:Class="AutomationTools.Views.ModbusClientView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:AutomationTools.ViewModels"
             xmlns:services="clr-namespace:AutomationTools.Services">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        
        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Control Bar -->
            <GroupBox Grid.Row="0" Header="{Binding [ModbusConnectionTheme], Source={x:Static services:TranslationSource.Instance}}" Style="{DynamicResource MaterialDesignGroupBox}" Margin="0,0,0,12" Padding="12">
                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontWeight="Bold" />
                    </DataTemplate>
                </GroupBox.HeaderTemplate>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="IP:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0" Foreground="{DynamicResource MaterialDesignBody}"/>
                    <TextBox Grid.Column="1" Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:HintAssist.Hint="{Binding [ModbusIpAddressHint], Source={x:Static services:TranslationSource.Instance}}"
                             VerticalAlignment="Center" FontWeight="Bold" Foreground="White" FontSize="16" Width="130" Margin="0,0,16,0">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <TextBlock Grid.Column="2" Text="Port:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0" Foreground="{DynamicResource MaterialDesignBody}"/>
                    <TextBox Grid.Column="3" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" FontWeight="Bold" Foreground="White" FontSize="16" Width="50" Margin="0,0,16,0">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <TextBlock Grid.Column="4" Text="{Binding [ModbusSlaveIdHint], Source={x:Static services:TranslationSource.Instance}, StringFormat='{}{0}:'}" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0" Foreground="{DynamicResource MaterialDesignBody}"/>
                    <TextBox Grid.Column="5" Text="{Binding SlaveId, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" FontWeight="Bold" Foreground="White" FontSize="16" Width="30">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Status Indicator -->
                    <Ellipse x:Name="StatusDot" Grid.Column="6" Width="12" Height="12" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#EF5350"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#4CAF50"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <Button Grid.Column="7" Command="{Binding ConnectClientCommand}" 
                            Content="{Binding [ConnectClient], Source={x:Static services:TranslationSource.Instance}}"
                            Width="100" Margin="0,0,16,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                            
                    <Button Grid.Column="7" Command="{Binding DisconnectClientCommand}" 
                            Content="{Binding [DisconnectClient], Source={x:Static services:TranslationSource.Instance}}"
                            Foreground="#EF5350" BorderBrush="#EF5350"
                            Width="100" Margin="0,0,16,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <ToggleButton Grid.Column="8" IsChecked="{Binding IsDebugPanelOpen}" Style="{StaticResource MaterialDesignActionToggleButton}" Width="32" Height="32" ToolTip="{Binding [ModbusDebug], Source={x:Static services:TranslationSource.Instance}}"
                                  Content="{materialDesign:PackIcon Kind=BugOutline}" materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon Kind=Bug}"/>

                </Grid>
            </GroupBox>

            <!-- Configuration Bar -->
            <GroupBox Grid.Row="1" Header="{Binding [ModbusDataConfigTheme], Source={x:Static services:TranslationSource.Instance}}" Style="{DynamicResource MaterialDesignGroupBox}" Margin="0,0,0,12" Padding="12">
                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontWeight="Bold" />
                    </DataTemplate>
                </GroupBox.HeaderTemplate>
                <Grid>
                    <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Configuration Row -->
                <WrapPanel Grid.Row="0" Margin="0,0,0,12">

                    <ComboBox Width="140" ItemsSource="{Binding RegisterTypes}" SelectedItem="{Binding SelectedRegisterType}" 
                              materialDesign:HintAssist.Hint="{Binding [ModbusRegisterTypeHint], Source={x:Static services:TranslationSource.Instance}}" 
                              Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="0,0,16,16"/>

                    <ComboBox Width="120" ItemsSource="{Binding DisplayModes}" SelectedItem="{Binding SelectedDisplayMode}" 
                              materialDesign:HintAssist.Hint="{Binding [ModbusDisplayFormatHint], Source={x:Static services:TranslationSource.Instance}}" Margin="0,0,16,16">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignFloatingHintComboBox}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedRegisterType}" Value="{x:Static viewmodels:ModbusRegisterType.Coil}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedRegisterType}" Value="{x:Static viewmodels:ModbusRegisterType.DiscreteInput}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>

                    <ComboBox Width="120" ItemsSource="{Binding WordOrders}" SelectedItem="{Binding SelectedWordOrder}" 
                              materialDesign:HintAssist.Hint="{Binding [ModbusWordOrderHint], Source={x:Static services:TranslationSource.Instance}}" Margin="0,0,16,16">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignFloatingHintComboBox}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedDisplayMode}" Value="{x:Static viewmodels:ModbusDisplayMode.Word16}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedDisplayMode}" Value="{x:Static viewmodels:ModbusDisplayMode.Byte8}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedDisplayMode}" Value="{x:Static viewmodels:ModbusDisplayMode.BitField}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedRegisterType}" Value="{x:Static viewmodels:ModbusRegisterType.Coil}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedRegisterType}" Value="{x:Static viewmodels:ModbusRegisterType.DiscreteInput}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>

                    <ComboBox Width="100" ItemsSource="{Binding NumericFormats}" SelectedItem="{Binding SelectedNumericFormat}" 
                              materialDesign:HintAssist.Hint="{Binding [ModbusNumericFormatHint], Source={x:Static services:TranslationSource.Instance}}" Margin="0,0,16,16">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignFloatingHintComboBox}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedDisplayMode}" Value="{x:Static viewmodels:ModbusDisplayMode.Byte8}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedDisplayMode}" Value="{x:Static viewmodels:ModbusDisplayMode.Word16}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedDisplayMode}" Value="{x:Static viewmodels:ModbusDisplayMode.Word32}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedRegisterType}" Value="{x:Static viewmodels:ModbusRegisterType.Coil}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedRegisterType}" Value="{x:Static viewmodels:ModbusRegisterType.DiscreteInput}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>

                    <TextBox Width="100" Text="{Binding StartAddress, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:HintAssist.Hint="{Binding [ModbusStartAddressHint], Source={x:Static services:TranslationSource.Instance}}" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,16,16"/>
                             
                    <TextBox Width="100" Text="{Binding RegisterCount, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:HintAssist.Hint="{Binding [ModbusClientRegisterCountHint], Source={x:Static services:TranslationSource.Instance}}" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,16,16"/>
                </WrapPanel>

                <!-- Polling & Action Row -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding PollingDelay, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:HintAssist.Hint="{Binding [ModbusPollingDelayHint], Source={x:Static services:TranslationSource.Instance}}" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" Width="150" Margin="0,0,16,0" HorizontalAlignment="Left"/>
                             
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,4">
                        <TextBlock Text="{Binding [ModbusEnablePolling], Source={x:Static services:TranslationSource.Instance}, StringFormat='{}{0} :'}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource MaterialDesignBody}"/>
                        <ToggleButton IsChecked="{Binding IsPolling}" IsEnabled="{Binding IsConnected}"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}" 
                                      ToolTip="{Binding [ModbusEnablePolling], Source={x:Static services:TranslationSource.Instance}}"/>
                    </StackPanel>

                    <Button Grid.Column="2" Command="{Binding ReadDataCommand}" 
                            Content="{Binding [ReadRegisters], Source={x:Static services:TranslationSource.Instance}}"
                            Style="{StaticResource MaterialDesignRaisedButton}" VerticalAlignment="Bottom"/>
                </Grid>
            </Grid>
            </GroupBox>

            <!-- Memory Grid -->
            <GroupBox Grid.Row="2" Header="{Binding [ModbusMemoryMapTheme], Source={x:Static services:TranslationSource.Instance}}" Style="{DynamicResource MaterialDesignGroupBox}" Padding="8">
                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontWeight="Bold" />
                    </DataTemplate>
                </GroupBox.HeaderTemplate>
                <DataGrid ItemsSource="{Binding Registers}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                          HeadersVisibility="Column" Background="Transparent" BorderThickness="0"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#33ffffff"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          PreviewMouseLeftButtonDown="DataGrid_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="DataGrid_PreviewMouseMove">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
                            <Setter Property="IsReadOnly" Value="True"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="IsReadOnly" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding [ModbusAddressHeader], Source={x:Static services:TranslationSource.Instance}}" Binding="{Binding Address}" IsReadOnly="True" Width="100"/>
                        <DataGridTextColumn Header="{Binding [ModbusValueHeader], Source={x:Static services:TranslationSource.Instance}}" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <!-- Debug Extension -->
        <Border Grid.Column="1" Width="280" Background="{DynamicResource MaterialDesignDarkBackground}" CornerRadius="4" Padding="8" Margin="0,0,0,12" Visibility="{Binding IsDebugPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="{Binding [ModbusPayload], Source={x:Static services:TranslationSource.Instance}}" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                    <Button Command="{Binding ClearLogsCommand}" Style="{StaticResource MaterialDesignFlatButton}" Content="{Binding [ModbusClearLogs], Source={x:Static services:TranslationSource.Instance}}" HorizontalAlignment="Right" Padding="4,0" Height="24"/>
                </DockPanel>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Logs}">
                    <ItemsControl.Template>
                        <ControlTemplate>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,2" Padding="4" Background="#11ffffff" CornerRadius="2">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss.fff}}" FontSize="10" Foreground="Gray" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Direction}" FontSize="10" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSent}" Value="False">
                                                            <Setter Property="Foreground" Value="#2196F3"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Payload}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
