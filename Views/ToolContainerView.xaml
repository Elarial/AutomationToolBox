<UserControl x:Class="AutomationTools.Views.ToolContainerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="{Binding Width, Mode=TwoWay}"
             Height="{Binding Height, Mode=TwoWay}"
             PreviewMouseDown="UserControl_PreviewMouseDown">
    <Grid>
        <!-- Main Content -->
        <Border Background="{DynamicResource MaterialDesignPaper}"
                CornerRadius="8"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" CornerRadius="8,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Thumb Grid.Column="0" DragDelta="TitleBar_DragDelta">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Grid Background="Transparent">
                                    <StackPanel Orientation="Horizontal" Margin="12,0">
                                        <materialDesign:PackIcon Kind="{Binding Content.IconKind}" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Content.Name}" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                    
                    <Button Grid.Column="1" Command="{Binding CloseCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" Width="40" Padding="0">
                        <materialDesign:PackIcon Kind="Close"/>
                    </Button>
                </Grid>
            </Border>
            
            <!-- Content -->
            <ContentControl Grid.Row="1" Content="{Binding Content}" Margin="8"/>
            
            <!-- Resize Grip -->
            <Thumb Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="Resize_DragDelta" Width="16" Height="16">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <materialDesign:PackIcon Kind="ResizeBottomRight" Foreground="{DynamicResource MaterialDesignBodyLight}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="12" Height="12" Margin="2"/>
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
    </Grid>
</UserControl>
