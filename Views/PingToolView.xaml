<UserControl x:Class="AutomationTools.Views.PingToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AutomationTools.ViewModels"
             xmlns:services="clr-namespace:AutomationTools.Services">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Input Section -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" 
                     Text="{Binding InputTarget, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="{Binding [PingInputHint], Source={x:Static services:TranslationSource.Instance}}"
                     VerticalAlignment="Bottom" Margin="0,0,16,0">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInputValid}" Value="False">
                                <Setter Property="Foreground" Value="#EF5350"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <Button Grid.Column="1" Command="{Binding StartPingCommand}" 
                    Content="{Binding [StartScan], Source={x:Static services:TranslationSource.Instance}}"
                    Style="{StaticResource MaterialDesignRaisedButton}" 
                    Width="100" Margin="0,0,8,0" VerticalAlignment="Bottom"/>

            <Button Grid.Column="2" Command="{Binding StopPingCommand}" 
                    Content="{Binding [StopScan], Source={x:Static services:TranslationSource.Instance}}"
                    Style="{StaticResource MaterialDesignOutlinedButton}" 
                    Foreground="#EF5350" BorderBrush="#EF5350"
                    Width="100" VerticalAlignment="Bottom"/>
        </Grid>

        <!-- Progress -->
        <ProgressBar Grid.Row="1" Minimum="0" Maximum="{Binding MaxProgress}" Value="{Binding TotalProgress}" 
                     Height="4" Margin="0,0,0,16" 
                     Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- Warning / Info -->
        <TextBlock Grid.Row="2" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="{Binding [PingWarningMessage], Source={x:Static services:TranslationSource.Instance}}" />
                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}" />
                    <Setter Property="FontStyle" Value="Italic" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsInputValid}" Value="False">
                            <Setter Property="Text" Value="{Binding DynamicWarning}" />
                            <Setter Property="Foreground" Value="#EF5350" />
                            <Setter Property="FontStyle" Value="Normal" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Results Grid -->
        <Border Grid.Row="3" Background="{DynamicResource MaterialDesignDarkBackground}" CornerRadius="8" Padding="16">
            <ListView ItemsSource="{Binding Results}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="4">
                            <!-- Status Dot -->
                            <Ellipse Width="12" Height="12" x:Name="StatusDot" Fill="Gray" Margin="0,0,12,0" VerticalAlignment="Center" />
                            
                            <!-- IP Address -->
                            <TextBlock Text="{Binding IpAddress}" VerticalAlignment="Center" Width="130" FontSize="14" />
                            
                            <!-- Latency -->
                            <TextBlock Text="{Binding RoundtripTime, StringFormat='\{0\} ms'}" x:Name="LatencyText" VerticalAlignment="Center" Width="60" Foreground="#4CAF50" Visibility="Collapsed" />
                            
                            <!-- Error Message -->
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF5350" VerticalAlignment="Center" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:PingStatus.Success}">
                                <Setter TargetName="StatusDot" Property="Fill" Value="#4CAF50"/>
                                <Setter TargetName="LatencyText" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:PingStatus.Failed}">
                                <Setter TargetName="StatusDot" Property="Fill" Value="#EF5350"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:PingStatus.Pending}">
                                <Setter TargetName="StatusDot" Property="Fill" Value="#757575"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</UserControl>
